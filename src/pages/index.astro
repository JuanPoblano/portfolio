---
import BaseLayout from "../layouts/BaseLayout.astro";
import Orbit from "../components/Orbit.astro";

import {
  profile,
  engineeringProjects,
  academicProjects,
  webProjects,
  experience,
  education,
  skillGroups,
  languages,
  interests,
  learningResources,
} from "../data/portfolio";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const projectUrl = (folder: string) => `${base}projects/${folder}/index.html`;
---

<BaseLayout>
  <main>
    <!-- HERO -->
    <section class="hero" id="home">
      <div class="container hero-grid">
        <div class="hero-content">
          <p class="hero-eyebrow" data-i18n="hero.eyebrow">
            SOFTWARE ENGINEERING · AVIONICS · IoT
          </p>

          <h1 class="hero-title">
            <span data-i18n="hero.title">From aircraft systems to</span>
            <span class="accent" data-i18n="hero.highlight">
              software engineering.
            </span>
          </h1>

          <p class="hero-description" data-i18n="hero.description">
            I'm Juan Poblano, a Computer Systems Engineering student
            specializing in IoT and Industry 4.0, with a background in avionics
            and international technical support.
          </p>

          <div class="hero-availability">
            <span class="status-dot"></span>
            <span data-i18n="hero.availability">
              Seeking university internships in Spain
            </span>
          </div>

          <div class="hero-actions">
            <a class="button" href="#projects" data-i18n="hero.explore">
              Explore my work
            </a>
            <a
              class="button button-outline"
              href="#contact"
              data-i18n="hero.contact"
            >
              Get in touch
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <Orbit />
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section class="section section-bordered" id="about">
      <div class="container">
        <span class="section-label" data-i18n="labels.about">
          01 / About me
        </span>

        <h2 class="section-title">
          <span data-i18n="content.aboutTitleFirst">
            Engineering mindset.
          </span>
          <span class="accent" data-i18n="content.aboutTitleAccent">
            Curiosity without borders.
          </span>
        </h2>

        <div class="about-grid">
          <div class="about-copy">
            <p data-i18n="content.aboutP1">
              My path started in aviation, where precision, safety and systems
              thinking are fundamental. Today, I'm extending that foundation
              into computer systems engineering and software development.
            </p>

            <p data-i18n="content.aboutP2">
              I'm particularly interested in the intersection of aerospace,
              connected devices, industrial automation and intelligent software
              systems.
            </p>

            <p data-i18n="content.aboutP3">
              I bring an international perspective shaped by technical support,
              manufacturing exposure and professional experience abroad.
            </p>
          </div>

          <div class="about-panel">
            <div class="fact">
              <span data-i18n="facts.focusLabel">CURRENT FOCUS</span>
              <strong data-i18n="facts.focus">
                Software · IoT · Industry 4.0
              </strong>
            </div>

            <div class="fact">
              <span data-i18n="facts.backgroundLabel">BACKGROUND</span>
              <strong data-i18n="facts.background">
                Avionics & aircraft systems
              </strong>
            </div>

            <div class="fact">
              <span data-i18n="facts.goalLabel">CURRENT GOAL</span>
              <strong data-i18n="facts.goal">
                University internship in Spain
              </strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ENGINEERING PROJECTS -->
    <section class="section section-bordered" id="projects">
      <div class="container">
        <span class="section-label" data-i18n="labels.engineering">
          02 / Selected work
        </span>

        <h2 class="section-title">
          <span data-i18n="content.engineeringTitleFirst">Engineering</span>
          <span class="accent" data-i18n="content.engineeringTitleAccent">
            projects.
          </span>
        </h2>

        <p class="muted section-intro" data-i18n="content.engineeringIntro">
          Projects exploring software, aerospace systems, industrial monitoring
          and applied engineering.
        </p>

        <div class="project-grid">
          {
            engineeringProjects.map((project, index) => (
              <article class="project-card">
                <div class="card-top">
                  <span class="project-number">{project.number}</span>
                  <span
                    class="project-status"
                    data-i18n={`engineeringProjects.${index}.status`}
                  >
                    {project.status}
                  </span>
                </div>

                <span
                  class="project-category"
                  data-i18n={`engineeringProjects.${index}.category`}
                >
                  {project.category}
                </span>

                <h3 data-i18n={`engineeringProjects.${index}.title`}>
                  {project.title}
                </h3>

                <p
                  class="muted"
                  data-i18n={`engineeringProjects.${index}.description`}
                >
                  {project.description}
                </p>

                <div class="tech-list">
                  {project.technologies.map((technology) => (
                    <span>{technology}</span>
                  ))}
                </div>

                <p
                  class="project-date"
                  data-i18n={`engineeringProjects.${index}.date`}
                >
                  {project.date}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ACADEMIC PROJECTS -->
    <section class="section section-bordered" id="academic-projects">
      <div class="container">
        <span class="section-label" data-i18n="labels.academic">
          03 / Academic engineering
        </span>

        <h2 class="section-title">
          <span data-i18n="content.academicTitleFirst">Applied learning</span>
          <span class="accent" data-i18n="content.academicTitleAccent">
            & achievements.
          </span>
        </h2>

        <p class="muted section-intro" data-i18n="content.academicIntro">
          Practical academic experiences in robotics, aircraft systems and
          technical problem-solving.
        </p>

        <div class="card-grid">
          {
            academicProjects.map((project, index) => (
              <article class="info-card">
                <span
                  class="project-category"
                  data-i18n={`academicProjects.${index}.category`}
                >
                  {project.category}
                </span>

                <h3 data-i18n={`academicProjects.${index}.title`}>
                  {project.title}
                </h3>

                <p class="card-meta">{project.institution}</p>

                <p
                  class="muted"
                  data-i18n={`academicProjects.${index}.description`}
                >
                  {project.description}
                </p>

                <div class="tech-list">
                  {project.technologies.map((technology) => (
                    <span>{technology}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- WEB PROJECTS -->
    <section class="section section-bordered" id="web-projects">
      <div class="container">
        <span class="section-label" data-i18n="labels.web">
          04 / Development archive
        </span>

        <h2 class="section-title">
          <span data-i18n="content.webTitleFirst">Frontend</span>
          <span class="accent" data-i18n="content.webTitleAccent">
            projects.
          </span>
        </h2>

        <p class="muted section-intro" data-i18n="content.webIntro">
          A collection of earlier web development exercises and projects,
          preserved as part of my learning journey.
        </p>

        <div class="web-grid">
          {
            webProjects.map((project, index) => (
              <a
                class="web-card"
                href={projectUrl(project.folder)}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span
                  class="project-category"
                  data-i18n={`webProjects.${index}.category`}
                >
                  {project.category}
                </span>

                <div class="web-card-bottom">
                  <h3>{project.name}</h3>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section class="section section-bordered" id="experience">
      <div class="container">
        <span class="section-label" data-i18n="labels.experience">
          05 / Professional background
        </span>

        <h2 class="section-title">
          <span data-i18n="content.experienceTitleFirst">Experience</span>
          <span class="accent" data-i18n="content.experienceTitleAccent">
            & growth.
          </span>
        </h2>

        <div class="timeline">
          {
            experience.map((job, index) => (
              <article class="timeline-item">
                <span class="timeline-period">{job.period}</span>

                <div class="timeline-content">
                  <h3 data-i18n={`experience.${index}.role`}>{job.role}</h3>

                  <p class="timeline-meta">
                    {job.company} · {job.location}
                  </p>

                  <p
                    class="muted"
                    data-i18n={`experience.${index}.description`}
                  >
                    {job.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="section section-bordered" id="education">
      <div class="container">
        <span class="section-label" data-i18n="labels.education">
          06 / Academic journey
        </span>

        <h2 class="section-title">
          <span data-i18n="content.educationTitleFirst">Education</span>
          <span class="accent" data-i18n="content.educationTitleAccent">
            & foundations.
          </span>
        </h2>

        <div class="card-grid">
          {
            education.map((item, index) => (
              <article class="info-card">
                <span class="card-period">{item.period}</span>

                <h3 data-i18n={`education.${index}.degree`}>{item.degree}</h3>

                <p class="card-meta">{item.school}</p>

                <p class="muted" data-i18n={`education.${index}.description`}>
                  {item.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SKILLS -->
    <section class="section section-bordered" id="skills">
      <div class="container">
        <span class="section-label" data-i18n="labels.skills">
          07 / Technical toolkit
        </span>

        <h2 class="section-title">
          <span data-i18n="content.skillsTitleFirst">Skills</span>
          <span class="accent" data-i18n="content.skillsTitleAccent">
            & languages.
          </span>
        </h2>

        <div class="skills-grid">
          {
            skillGroups.map((group, index) => (
              <article class="info-card">
                <h3 data-i18n={`skillGroups.${index}.title`}>{group.title}</h3>

                <div class="tech-list">
                  {group.skills.map((skill) => (
                    <span>{skill}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        <div class="languages-grid">
          {
            languages.map((language, index) => (
              <div class="language-card">
                <strong data-i18n={`languages.${index}.name`}>
                  {language.name}
                </strong>
                <span data-i18n={`languages.${index}.level`}>
                  {language.level}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- LEARNING -->
    <section class="section section-bordered" id="learning">
      <div class="container">
        <span class="section-label" data-i18n="labels.learning">
          08 / Continuous learning
        </span>

        <h2 class="section-title">
          <span data-i18n="content.learningTitleFirst">Always</span>
          <span class="accent" data-i18n="content.learningTitleAccent">
            learning.
          </span>
        </h2>

        <p class="muted section-intro" data-i18n="content.learningIntro">
          Technical education, verified training records and independent
          learning beyond formal university studies.
        </p>

        <div class="card-grid">
          {
            learningResources.map((resource, index) => (
              <a
                class="info-card link-card"
                href={resource.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span
                  class="project-category"
                  data-i18n={`learningResources.${index}.category`}
                >
                  {resource.category}
                </span>

                <h3>{resource.title} ↗</h3>

                <p
                  class="muted"
                  data-i18n={`learningResources.${index}.description`}
                >
                  {resource.description}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- INTERESTS -->
    <section class="section section-bordered" id="interests">
      <div class="container">
        <span class="section-label" data-i18n="labels.interests">
          09 / Beyond engineering
        </span>

        <h2 class="section-title">
          <span data-i18n="content.interestsTitleFirst">More than</span>
          <span class="accent" data-i18n="content.interestsTitleAccent">
            code.
          </span>
        </h2>

        <div class="card-grid">
          {
            interests.map((interest, index) => (
              <article class="info-card">
                <span class="interest-icon" aria-hidden="true">
                  {interest.icon}
                </span>

                <h3 data-i18n={`interests.${index}.title`}>{interest.title}</h3>

                <p class="muted" data-i18n={`interests.${index}.description`}>
                  {interest.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section section-bordered contact-section" id="contact">
      <div class="container">
        <span class="section-label" data-i18n="labels.contact">
          10 / Let's connect
        </span>

        <h2 class="section-title">
          <span data-i18n="content.contactTitleFirst"
            >Let's build something</span
          >
          <span class="accent" data-i18n="content.contactTitleAccent">
            meaningful.
          </span>
        </h2>

        <p class="muted section-intro" data-i18n="content.contactIntro">
          Interested in aerospace, software engineering, IoT and Industry 4.0.
          Currently exploring curricular and extracurricular university
          internship opportunities in Spain.
        </p>

        <div class="hero-actions">
          <a
            class="button"
            href={`mailto:${profile.email}`}
            data-i18n="content.emailButton"
          >
            Send an email
          </a>

          <a
            class="button button-outline"
            href={profile.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn ↗
          </a>

          <a
            class="button button-outline"
            href={profile.social.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span data-i18n="footer.tagline">
        Built with curiosity, code & tea.
      </span>
    </div>
  </footer>
</BaseLayout>

<style>
  .accent {
    color: #60d5d7;
  }

  .section-bordered {
    border-top: 1px solid rgba(255, 255, 255, 0.075);
  }

  .hero {
    padding: 115px 0 110px;
    min-height: 650px;
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: center;
    gap: 50px;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow,
  .project-category,
  .section-label {
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-eyebrow {
    color: #60d5d7;
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 22px;
  }

  .hero-title {
    font-size: clamp(2.8rem, 5.5vw, 5.6rem);
    line-height: 1.08;
    letter-spacing: -0.055em;
    margin: 0 0 25px;
    font-weight: 700;
  }

  .hero-title > span {
    display: block;
  }

  .hero-description {
    max-width: 620px;
    color: #a9bacb;
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .hero-availability {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 25px;
    font-size: 0.87rem;
    color: #b9d8d9;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #60d5d7;
    box-shadow: 0 0 12px rgba(96, 213, 215, 0.65);
    flex-shrink: 0;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 30px;
  }

  .hero-visual {
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .section-intro {
    max-width: 760px;
    line-height: 1.8;
    margin: 0 0 34px;
  }

  .section-title {
    max-width: 950px;
    margin-bottom: 22px;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 60px;
  }

  .about-copy p {
    color: #a9bacb;
    line-height: 1.9;
    margin-bottom: 18px;
  }

  .about-panel,
  .project-card,
  .info-card,
  .web-card,
  .language-card {
    background: rgba(14, 29, 46, 0.78);
    border: 1px solid rgba(133, 165, 188, 0.15);
    border-radius: 16px;
  }

  .about-panel {
    padding: 28px;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 17px 0;
  }

  .fact + .fact {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .fact > span {
    color: #60d5d7;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .fact strong {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .project-grid,
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .project-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    min-height: 350px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 28px;
  }

  .project-number {
    color: #60d5d7;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .project-status {
    color: #a6c9c9;
    background: rgba(96, 213, 215, 0.09);
    border: 1px solid rgba(96, 213, 215, 0.18);
    padding: 6px 9px;
    border-radius: 6px;
    font-size: 0.68rem;
  }

  .project-category {
    color: #60d5d7;
    font-size: 0.66rem;
    font-weight: 700;
    margin-bottom: 12px;
    display: block;
  }

  .project-card h3,
  .info-card h3,
  .web-card h3 {
    font-size: 1.18rem;
    line-height: 1.4;
    margin: 0 0 15px;
  }

  .project-card > p,
  .info-card > p {
    line-height: 1.75;
    font-size: 0.9rem;
  }

  .tech-list {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 22px;
  }

  .tech-list span {
    color: #b6c9d8;
    border: 1px solid rgba(133, 165, 188, 0.2);
    background: rgba(255, 255, 255, 0.025);
    padding: 6px 9px;
    border-radius: 6px;
    font-size: 0.7rem;
  }

  .project-date {
    margin-top: auto;
    padding-top: 20px;
    color: #7892a6;
    font-size: 0.75rem !important;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .info-card {
    padding: 27px;
    min-width: 0;
  }

  .card-meta {
    color: #60d5d7;
    font-size: 0.82rem;
    margin-bottom: 15px;
  }

  .card-period {
    display: block;
    color: #60d5d7;
    font-size: 0.75rem;
    margin-bottom: 17px;
  }

  .web-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .web-card {
    padding: 25px;
    min-height: 145px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s,
      border-color 0.2s;
  }

  .web-card:hover,
  .link-card:hover {
    transform: translateY(-4px);
    border-color: rgba(96, 213, 215, 0.5);
  }

  .web-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .web-card-bottom h3 {
    margin: 0;
  }

  .web-card-bottom > span {
    color: #60d5d7;
    font-size: 1.4rem;
  }

  .timeline {
    border-left: 1px solid rgba(96, 213, 215, 0.22);
    margin-left: 8px;
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 30px;
    padding: 0 0 42px 30px;
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 7px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #60d5d7;
  }

  .timeline-period {
    color: #60d5d7;
    font-size: 0.78rem;
    padding-top: 5px;
  }

  .timeline-content h3 {
    margin: 0 0 8px;
    font-size: 1.15rem;
  }

  .timeline-meta {
    color: #b4c8d5;
    margin-bottom: 13px;
    font-size: 0.85rem;
  }

  .timeline-content .muted {
    max-width: 750px;
    line-height: 1.8;
  }

  .languages-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 22px;
  }

  .language-card {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .language-card strong {
    font-size: 0.94rem;
  }

  .language-card span {
    color: #9eb4c6;
    font-size: 0.8rem;
  }

  .link-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s,
      border-color 0.2s;
  }

  .interest-icon {
    display: inline-block;
    font-size: 2rem;
    color: #60d5d7;
    margin-bottom: 15px;
  }

  .contact-section {
    padding-bottom: 115px;
  }

  .footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 28px 0;
    color: #8da6b9;
    font-size: 0.78rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

