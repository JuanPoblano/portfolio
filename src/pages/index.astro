---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/redesign.css";
import { editorial } from "../i18n/editorial";
const t = (key: string, fallback = key) => editorial.en[key] ?? fallback;

import {
  profile,
  engineeringProjects,
  academicProjects,
  webProjects,
  experience,
  education,
  skillGroups,
  languages,
  interests,
  learningResources,
} from "../data/portfolio";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const projectUrl = (folder: string) => `${base}projects/${folder}/index.html`;
const featuredAircraftProject = engineeringProjects[0];
const roadmapProjects = engineeringProjects.slice(1);
---

<BaseLayout>
  <a class="skip-link" href="#home" data-i18n="new.skip">{t('new.skip')}</a>
  <main>
    <!-- HERO -->
    <section class="hero" id="home">
      <div class="container hero-grid">
        <div class="hero-content">
          <p class="hero-eyebrow" data-i18n="hero.eyebrow">{t('hero.eyebrow')}</p>
          <p class="identity">Juan<br/>Poblano<span>.</span></p>
          <h1 class="hero-title"><span data-i18n="hero.title">{t('hero.title')}</span> <span class="accent" data-i18n="hero.highlight">{t('hero.highlight')}</span></h1>
          <p class="hero-description" data-i18n="hero.description">{t('hero.description')}</p>
          <div class="hero-availability">
            <span class="status-dot"></span>
            <span data-i18n="hero.availability">{t('hero.availability')}</span>
          </div>

          <div class="hero-actions">
            <a class="button" href="#academic-projects" data-i18n="hero.explore">{t('hero.explore')}</a>
            <a
              class="button button-outline"
              href="#contact"
              data-i18n="hero.contact"
            >{t('hero.contact')}</a>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="visual-top"><span>JP / SYSTEMS FIELDNOTES</span><span>01 — 2026</span></div>
          <svg class="signal-art" viewBox="0 0 500 420" fill="none"><g stroke="currentColor" opacity=".16"><path d="M0 105H500M0 210H500M0 315H500M100 0V420M200 0V420M300 0V420M400 0V420"/><circle cx="250" cy="210" r="145"/><circle cx="250" cy="210" r="90"/><path d="M40 210H460M250 25V395"/></g><g class="signal-ring" stroke="currentColor"><ellipse cx="250" cy="210" rx="210" ry="65" transform="rotate(-35 250 210)"/><ellipse cx="250" cy="210" rx="165" ry="125" transform="rotate(30 250 210)"/></g><path class="signal-line" d="M25 230H95L120 190L145 265L180 135L220 290L255 160L285 230H475" stroke="currentColor" stroke-width="3"/><circle cx="250" cy="210" r="5" fill="currentColor"/></svg>
          <div class="visual-bottom"><span>SOFTWARE<br/>TELEMETRY<br/>CONNECTED SYSTEMS</span><span class="visual-plus">+</span></div>
        </div>
      </div>
    </section>


    <!-- ABOUT -->
    <section class="section section-bordered" id="about">
      <div class="container">
        <span class="section-label" data-i18n="labels.about">{t('labels.about')}</span>

        <h2 class="section-title">
          <span data-i18n="content.aboutTitleFirst">{t('content.aboutTitleFirst')}</span>
          <span class="accent" data-i18n="content.aboutTitleAccent">{t('content.aboutTitleAccent')}</span>
        </h2>

        <div class="about-grid">
          <div class="about-copy">
            <p data-i18n="content.aboutP1">{t('content.aboutP1')}</p>

            <p data-i18n="content.aboutP2">{t('content.aboutP2')}</p>

            <p data-i18n="content.aboutP3">{t('content.aboutP3')}</p>
          </div>

          <div class="about-panel">
            <div class="fact">
              <span data-i18n="facts.focusLabel">CURRENT FOCUS</span>
              <strong data-i18n="facts.focus">
                {t('facts.focus')}
              </strong>
            </div>

            <div class="fact">
              <span data-i18n="facts.backgroundLabel">BACKGROUND</span>
              <strong data-i18n="facts.background">
                Avionics & aircraft systems
              </strong>
            </div>

            <div class="fact">
              <span data-i18n="facts.goalLabel">CURRENT GOAL</span>
              <strong data-i18n="facts.goal">
                University internship in Spain
              </strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ENGINEERING PROJECTS -->
    <section class="section section-bordered" id="projects">
      <div class="container">
        <span class="section-label" data-i18n="labels.engineering">{t('labels.engineering')}</span>

        <h2 class="section-title">
          <span data-i18n="content.engineeringTitleFirst">{t('content.engineeringTitleFirst')}</span>{" "}
          <span class="accent" data-i18n="content.engineeringTitleAccent">{t('content.engineeringTitleAccent')}</span>
        </h2>

        <p class="muted section-intro" data-i18n="content.engineeringIntro">{t('content.engineeringIntro')}</p>

        <article class="project-card featured-project">
          <div class="featured-project__details">
            <div class="card-top">
              <span class="project-number">{featuredAircraftProject.number}</span>
              <span
                class="project-status"
                data-i18n={`engineeringProjects.${featuredAircraftProject.id}.status`}
              >
                {featuredAircraftProject.status}
              </span>
            </div>

            <span
              class="project-category"
              data-i18n={`engineeringProjects.${featuredAircraftProject.id}.category`}
            >
              {featuredAircraftProject.category}
            </span>

            <h3 data-i18n={`engineeringProjects.${featuredAircraftProject.id}.title`}>
              {featuredAircraftProject.title}
            </h3>

            <p
              class="muted"
              data-i18n={`engineeringProjects.${featuredAircraftProject.id}.description`}
            >
              {featuredAircraftProject.description}
            </p>

            <p
              class="muted featured-project__summary"
              data-i18n={`engineeringProjects.${featuredAircraftProject.id}.details`}
            >
              {featuredAircraftProject.details}
            </p>

            <div class="tech-list">
              {featuredAircraftProject.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>

            <p
              class="project-date"
              data-i18n={`engineeringProjects.${featuredAircraftProject.id}.date`}
            >
              {featuredAircraftProject.date}
            </p>

            <div class="featured-project__actions">
              <a
                class="button"
                href={featuredAircraftProject.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-i18n="aircraftProject.liveDemo"
              >
                {t("aircraftProject.liveDemo")}
              </a>
              <a
                class="button button-outline"
                href={featuredAircraftProject.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-i18n="aircraftProject.sourceCode"
              >
                {t("aircraftProject.sourceCode")}
              </a>
            </div>
          </div>

          <div
            class="aircraft-gallery"
            role="group"
            aria-label={t("aircraftGallery.label")}
            data-i18n="aircraftGallery.label"
            data-i18n-attr="aria-label"
          >
            <img
              class="aircraft-gallery__main-image"
              src={`${base}images/aircraft-systems/overview.png`}
              alt={t("aircraftGallery.normal.alt")}
              data-aircraft-main-image
              loading="lazy"
              decoding="async"
              width="1560"
              height="888"
            />
            <button
              class="aircraft-gallery__item is-active"
              type="button"
              aria-pressed="true"
              aria-label={t("aircraftGallery.normal.label")}
              data-i18n="aircraftGallery.normal.label"
              data-i18n-attr="aria-label"
              data-aircraft-image
            >
              <img
                src={`${base}images/aircraft-systems/overview.png`}
                alt={t("aircraftGallery.normal.alt")}
                data-i18n="aircraftGallery.normal.alt"
                data-i18n-attr="alt"
                loading="lazy"
                decoding="async"
                width="1560"
                height="888"
              />
              <span data-i18n="aircraftGallery.normal.caption">
                {t("aircraftGallery.normal.caption")}
              </span>
            </button>
            <button
              class="aircraft-gallery__item"
              type="button"
              aria-pressed="false"
              aria-label={t("aircraftGallery.fault.label")}
              data-i18n="aircraftGallery.fault.label"
              data-i18n-attr="aria-label"
              data-aircraft-image
            >
              <img
                src={`${base}images/aircraft-systems/fault-detected.png`}
                alt={t("aircraftGallery.fault.alt")}
                data-i18n="aircraftGallery.fault.alt"
                data-i18n-attr="alt"
                loading="lazy"
                decoding="async"
                width="1560"
                height="888"
              />
              <span data-i18n="aircraftGallery.fault.caption">
                {t("aircraftGallery.fault.caption")}
              </span>
            </button>
            <button
              class="aircraft-gallery__item"
              type="button"
              aria-pressed="false"
              aria-label={t("aircraftGallery.telemetry.label")}
              data-i18n="aircraftGallery.telemetry.label"
              data-i18n-attr="aria-label"
              data-aircraft-image
            >
              <img
                src={`${base}images/aircraft-systems/telemetry.png`}
                alt={t("aircraftGallery.telemetry.alt")}
                data-i18n="aircraftGallery.telemetry.alt"
                data-i18n-attr="alt"
                loading="lazy"
                decoding="async"
                width="1560"
                height="888"
              />
              <span data-i18n="aircraftGallery.telemetry.caption">
                {t("aircraftGallery.telemetry.caption")}
              </span>
            </button>
            <button
              class="aircraft-gallery__item"
              type="button"
              aria-pressed="false"
              aria-label={t("aircraftGallery.flightSimulation.label")}
              data-i18n="aircraftGallery.flightSimulation.label"
              data-i18n-attr="aria-label"
              data-aircraft-image
              data-aircraft-image-fit="contain"
            >
              <img
                src={`${base}images/aircraft-systems/flight-simulation-cropped.png`}
                alt={t("aircraftGallery.flightSimulation.alt")}
                data-i18n="aircraftGallery.flightSimulation.alt"
                data-i18n-attr="alt"
                loading="lazy"
                decoding="async"
                width="1896"
                height="888"
              />
              <span data-i18n="aircraftGallery.flightSimulation.caption">
                {t("aircraftGallery.flightSimulation.caption")}
              </span>
            </button>
          </div>
        </article>

        <details class="section-disclosure roadmap-disclosure">
          <summary>
            <span data-i18n="compact.roadmap">{t("compact.roadmap")}</span>
            <span class="disclosure-mark" aria-hidden="true">+</span>
          </summary>
          <div class="disclosure-body">
            <div class="project-grid">
              {
                roadmapProjects.map((project) => (
                  <article class="project-card">
                    <div class="card-top">
                      <span class="project-number">{project.number}</span>
                      <span
                        class="project-status"
                        data-i18n={`engineeringProjects.${project.id}.status`}
                      >
                        {project.status}
                      </span>
                    </div>

                    <span
                      class="project-category"
                      data-i18n={`engineeringProjects.${project.id}.category`}
                    >
                      {project.category}
                    </span>

                    <h3 data-i18n={`engineeringProjects.${project.id}.title`}>
                      {project.title}
                    </h3>

                    <p
                      class="muted"
                      data-i18n={`engineeringProjects.${project.id}.description`}
                    >
                      {project.description}
                    </p>

                    <div class="tech-list">
                      {project.technologies.map((technology) => (
                        <span>{technology}</span>
                      ))}
                    </div>

                    <details>
                      <summary data-i18n="new.scope">{t("new.scope")}</summary>
                      <p data-i18n={`new.scopes.${project.id}`}>
                        {t(`new.scopes.${project.id}`)}
                      </p>
                    </details>
                    <p
                      class="project-date"
                      data-i18n={`engineeringProjects.${project.id}.date`}
                    >
                      {project.date}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </details>
      </div>
    </section>

    <section class="section field-section" id="fieldwork"><div class="container">
      <p class="section-label" data-i18n="new.featureLabel">{t('new.featureLabel')}</p>
      <div class="section-heading"><h2 class="section-title" data-i18n="new.rochTitle">{t('new.rochTitle')}</h2><p class="muted" data-i18n="new.rochIntro">{t('new.rochIntro')}</p></div>
      <article class="field-card"><div class="rover-art"><span class="art-label">ROCH TEAM / UNAQ / 2020</span>
      <svg viewBox="0 0 600 340" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="2"><path opacity=".2" d="M20 295H580M50 270H550M150 50V310M300 30V310M450 50V310"/><circle cx="165" cy="255" r="48"/><circle cx="440" cy="255" r="48"/><circle cx="165" cy="255" r="30"/><circle cx="440" cy="255" r="30"/><path d="M165 255L245 155H350L440 255H165L250 205L350 155M245 155L220 105H310L350 155M300 150V75H330M295 75H340M260 205H355L390 125H430M350 205L440 255"/><path class="rover-signal" d="M345 50Q385 75 345 100M360 35Q420 75 360 115M375 20Q455 75 375 130" stroke="#bca0ff"/><circle cx="300" cy="75" r="6" fill="#bca0ff"/></g></svg>
      <small data-i18n="new.visualNote">{t('new.visualNote')}</small></div>
      <div class="field-copy"><p class="project-category" data-i18n="new.rochRole">{t('new.rochRole')}</p><h3 data-i18n="new.top">{t('new.top')}</h3><p data-i18n="new.rochCopy">{t('new.rochCopy')}</p><div class="tech-list"><span>Raspberry Pi</span><span data-i18n="compact.motionSensors">Motion sensors</span><span data-i18n="compact.temperatureSensors">Temperature sensors</span></div><div class="award"><span data-i18n="new.award">{t('new.award')}</span><p data-i18n="new.evidence">{t('new.evidence')}</p></div><a class="text-link" href="https://www.unaq.edu.mx/en/soyunaq/equipos-representativos/roch-team-unaq/" target="_blank" rel="noopener noreferrer" data-i18n="new.source">{t('new.source')}</a></div></article>
    </div></section>
    <!-- ACADEMIC PROJECTS -->
    <section class="section section-bordered" id="academic-projects">
      <div class="container">
        <span class="section-label" data-i18n="labels.academic">{t('labels.academic')}</span>

        <h2 class="section-title">
          <span data-i18n="content.academicTitleFirst">Applied learning</span>
          <span class="accent" data-i18n="content.academicTitleAccent">
            & achievements.
          </span>
        </h2>

        <p class="muted section-intro" data-i18n="content.academicIntro">
          Practical academic experiences in robotics, aircraft systems and
          technical problem-solving.
        </p>

        <div class="card-grid">
          {
            academicProjects.map((project) => (
              <article class="info-card">
                <span
                  class="project-category"
                  data-i18n={`academicProjects.${project.id}.category`}
                >
                  {project.category}
                </span>

                <h3 data-i18n={`academicProjects.${project.id}.title`}>
                  {t(`academicProjects.${project.id}.title`, project.title)}
                </h3>

                <p class="card-period" data-i18n={`academicProjects.${project.id}.date`}>
                  {project.date}
                </p>

                <p class="card-meta">{project.institution}</p>

                <p
                  class="muted"
                  data-i18n={`academicProjects.${project.id}.description`}
                >
                  {t(`academicProjects.${project.id}.description`, project.description)}
                </p>

                {project.id === 'wer-mexico' && <a class="text-link" href="https://www.wermexico.com/wer2017" target="_blank" rel="noopener noreferrer" data-i18n="academicProjects.wer-mexico.link">{t("academicProjects.wer-mexico.link")}</a>}
                <div class="tech-list">
                  {project.technologies.map((technology) => (
                    <span>{technology}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
        <aside class="competition-note"><strong data-i18n="new.other">{t('new.other')}</strong><p data-i18n="new.robomath">{t('new.robomath')}</p></aside>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section class="section section-bordered" id="experience">
      <div class="container">
        <span class="section-label" data-i18n="labels.experience">{t('labels.experience')}</span>

        <h2 class="section-title">
          <span data-i18n="content.experienceTitleFirst">Experience</span>
          <span class="accent" data-i18n="content.experienceTitleAccent">
            & growth.
          </span>
        </h2>

        <div class="timeline">
          {
            experience.map((job, index) => (
              <article class="timeline-item">
                <span class="timeline-period">{job.period}</span>

                <div class="timeline-content">
                  <h3 data-i18n={`experience.${index}.role`}>{t(`experience.${index}.role`, job.role)}</h3>

                  <p class="timeline-meta">
                    {job.company} · {job.location}
                  </p>

                  <p
                    class="muted"
                    data-i18n={`experience.${index}.description`}
                  >
                    {t(`experience.${index}.description`, job.description)}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- EDUCATION -->
    <section class="section section-bordered" id="education">
      <div class="container">
        <span class="section-label" data-i18n="labels.education">{t('labels.education')}</span>

        <h2 class="section-title">
          <span data-i18n="content.educationTitleFirst">Education</span>
          <span class="accent" data-i18n="content.educationTitleAccent">
            & foundations.
          </span>
        </h2>

        <div class="card-grid">
          {
            education.map((item) => (
              <article class="info-card">
                <span class="card-period" data-i18n={`education.${item.id}.period`}>
                  {t(`education.${item.id}.period`, item.period)}
                </span>

                <h3 data-i18n={`education.${item.id}.degree`}>{t(`education.${item.id}.degree`, item.degree)}</h3>

                <p class="card-meta">{item.school}</p>

                <p class="muted" data-i18n={`education.${item.id}.description`}>
                  {t(`education.${item.id}.description`, item.description)}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- SKILLS -->
    <section class="section section-bordered" id="skills">
      <div class="container">
        <span class="section-label" data-i18n="labels.skills">{t('labels.skills')}</span>

        <h2 class="section-title">
          <span data-i18n="content.skillsTitleFirst">Skills</span>
          <span class="accent" data-i18n="content.skillsTitleAccent">
            & languages.
          </span>
        </h2>

        <div class="skills-grid">
          {
            skillGroups.map((group, index) => (
              <article class="info-card">
                <h3 data-i18n={`skillGroups.${index}.title`}>{t(`skillGroups.${index}.title`, group.title)}</h3>

                <div class="tech-list">
                  {group.skills.map((skill, skillIndex) => (
                    <span data-i18n={`skillGroups.${index}.skills.${skillIndex}`}>{t(`skillGroups.${index}.skills.${skillIndex}`, skill)}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        <div class="languages-grid">
          {
            languages.map((language, index) => (
              <div class="language-card">
                <strong data-i18n={`languages.${index}.name`}>
                  {t(`languages.${index}.name`, language.name)}
                </strong>
                <span data-i18n={`languages.${index}.level`}>
                  {t(`languages.${index}.level`, language.level)}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- WEB PROJECTS -->
    <section class="section section-bordered" id="web-projects">
      <div class="container">
        <span class="section-label" data-i18n="labels.web">{t('labels.web')}</span>

        <h2 class="section-title">
          <span data-i18n="content.webTitleFirst">Frontend</span>
          <span class="accent" data-i18n="content.webTitleAccent">
            projects.
          </span>
        </h2>

        <p class="muted section-intro" data-i18n="content.webIntro">
          A collection of earlier web development exercises and projects,
          preserved as part of my learning journey.
        </p>

        <div class="web-grid">
          {
            webProjects.map((project, index) => (
              <a
                class="web-card"
                href={projectUrl(project.folder)}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span
                  class="project-category"
                  data-i18n={`webProjects.${index}.category`}
                >
                  {project.category}
                </span>

                <div class="web-card-bottom">
                  <h3>{project.name}</h3>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- LEARNING -->
    <section class="section section-bordered" id="learning">
      <div class="container">
        <span class="section-label" data-i18n="labels.learning">{t('labels.learning')}</span>

<details class="section-disclosure"><summary>        <h2 class="section-title">
          <span data-i18n="content.learningTitleFirst">Always</span>
          <span class="accent" data-i18n="content.learningTitleAccent">
            learning.
          </span>
        </h2><span class="disclosure-caption" data-i18n="compact.learning">{t("compact.learning")}</span><span class="disclosure-mark" aria-hidden="true">+</span></summary><div class="disclosure-body">

        <p class="muted section-intro" data-i18n="content.learningIntro">
          Technical education, verified training records and independent
          learning beyond formal university studies.
        </p>

        <div class="card-grid">
          {
            learningResources.map((resource, index) => (
              <a
                class="info-card link-card"
                href={resource.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span
                  class="project-category"
                  data-i18n={`learningResources.${index}.category`}
                >
                  {resource.category}
                </span>

                <h3>{resource.title} ↗</h3>

                <p
                  class="muted"
                  data-i18n={`learningResources.${index}.description`}
                >
                  {resource.description}
                </p>
              </a>
            ))
          }
        </div>
</div><p class="compact-youtube"><a href={profile.social.youtube} target="_blank" rel="noopener noreferrer" data-i18n="new.youtube">{t('new.youtube')}</a></p></details>
      </div>
    </section>

    <!-- INTERESTS -->
    <section class="section section-bordered" id="interests">
      <div class="container">
        <span class="section-label" data-i18n="labels.interests">{t('labels.interests')}</span>

<details class="section-disclosure"><summary>        <h2 class="section-title">
          <span data-i18n="content.interestsTitleFirst">More than</span>
          <span class="accent" data-i18n="content.interestsTitleAccent">
            code.
          </span>
        </h2><span class="disclosure-caption" data-i18n="compact.interests">{t("compact.interests")}</span><span class="disclosure-mark" aria-hidden="true">+</span></summary><div class="disclosure-body">

        <div class="card-grid">
          {
            interests.map((interest, index) => (
              <article class="info-card">
                <span class="interest-icon" aria-hidden="true">
                  {interest.icon}
                </span>

                <h3 data-i18n={`interests.${index}.title`}>{t(`interests.${index}.title`, interest.title)}</h3>

                <p class="muted" data-i18n={`interests.${index}.description`}>
                  {t(`interests.${index}.description`, interest.description)}
                </p>
              </article>
            ))
          }
        </div>
</div></details>
      </div>
    </section>

    <!-- CONTACT -->
    <section class="section section-bordered contact-section" id="contact">
      <div class="container">
        <span class="section-label" data-i18n="labels.contact">{t('labels.contact')}</span>

        <h2 class="section-title">
          <span data-i18n="content.contactTitleFirst"
            >Let's build something</span
          >
          <span class="accent" data-i18n="content.contactTitleAccent">
            meaningful.
          </span>
        </h2>

        <p class="muted section-intro" data-i18n="content.contactIntro">{t('content.contactIntro')}</p>

        <div class="hero-actions">
          <a
            class="button"
            href={`mailto:${profile.email}`}
            data-i18n="content.emailButton"
          >
            Send an email
          </a>

          <a
            class="button button-outline"
            href={profile.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn ↗
          </a>

          <a
            class="button button-outline"
            href={profile.social.github}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>
          <button class="button button-outline copy-email" data-email={profile.email} data-i18n="new.copy">{t('new.copy')}</button><span class="copy-feedback" role="status"></span>
        </div>
      </div>
    </section>
  </main>

  <button class="motion-toggle" type="button" aria-pressed="false" data-i18n="new.pause">{t("new.pause")}</button>
  <footer class="footer">
    <div class="container footer-inner">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span data-i18n="footer.tagline">
        Built with curiosity, code & tea.
      </span>
    </div>
  </footer>
<script>
  import { editorial } from "../i18n/editorial";
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => entries.forEach(entry => { if(entry.isIntersecting){entry.target.classList.add('visible');observer.unobserve(entry.target);} }), {threshold:0.08});
    document.querySelectorAll('.info-card,.project-card,.field-card,.timeline-item').forEach(el=>{el.classList.add('reveal');observer.observe(el);});
  }
  const motionButton = document.querySelector<HTMLButtonElement>('.motion-toggle');
  let motionOff = reduced;
  try { motionOff = localStorage.getItem('juan-motion') === 'off' || reduced; } catch {}
  const applyMotion = () => {
    document.documentElement.dataset.motion = motionOff ? 'off' : 'on';
    motionButton?.setAttribute('aria-pressed', String(motionOff));
    if(motionButton){
      motionButton.dataset.i18n=motionOff?'new.resume':'new.pause';
      motionButton.textContent=editorial[document.documentElement.lang]?.[motionButton.dataset.i18n] ?? (motionOff?'Resume animations':'Pause animations');
    }
  };
  applyMotion();
  motionButton?.addEventListener('click',()=>{motionOff=!motionOff;applyMotion();try{localStorage.setItem('juan-motion',motionOff?'off':'on');}catch{}});
  const navObserver = new IntersectionObserver(entries=>entries.forEach(entry=>{
    if(entry.isIntersecting){document.querySelectorAll('.navigation a[href^="#"]').forEach(link=>{
      const active=link.getAttribute('href')==='#'+entry.target.id;
      if(active)link.setAttribute('aria-current','location');else link.removeAttribute('aria-current');
    });}
  }),{rootMargin:'-15% 0px -65% 0px'});
  document.querySelectorAll('main>section[id]').forEach(section=>navObserver.observe(section));
  document.querySelector<HTMLButtonElement>('.copy-email')?.addEventListener('click',async event=>{
    const button=event.currentTarget as HTMLButtonElement;
    const output=document.querySelector<HTMLElement>('.copy-feedback');
    try{await navigator.clipboard.writeText(button.dataset.email ?? '');if(output)output.textContent=editorial[document.documentElement.lang]?.['new.copied'] ?? 'Email copied';}
    catch{if(output)output.textContent=button.dataset.email ?? '';}
  });
</script>
</BaseLayout>
